                  <outputColumns>
                    <outputColumn
                      refId="Package\Cargar DimCliente\Columna derivada.Outputs[Salida de columna derivada].Columns[Zona]"
                      dataType="wstr"
                      errorOrTruncationOperation="Cálculo"
                      errorRowDisposition="FailComponent"
                      length="18"
                      lineageId="Package\Cargar DimCliente\Columna derivada.Outputs[Salida de columna derivada].Columns[Zona]"
                      name="Zona"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión de columna derivada"
                          name="Expression">(#{Package\Cargar DimCliente\Combinación de mezcla 2.Outputs[Salida de combinación de mezcla].Columns[NombreProvincia]} == "LIMA" || #{Package\Cargar DimCliente\Combinación de mezcla 2.Outputs[Salida de combinación de mezcla].Columns[NombreProvincia]} == "CALLAO") ? "LIMA METROPOLITANA" : (#{Package\Cargar DimCliente\Combinación de mezcla 2.Outputs[Salida de combinación de mezcla].Columns[NombreProvincia]} == "NO REGISTRADO" ? "NO REGISTRADO" : "PROVINCIAS")</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión descriptiva de columna derivada"
                          expressionType="Notify"
                          name="FriendlyExpression">(NombreProvincia == "LIMA" || NombreProvincia == "CALLAO") ? "LIMA METROPOLITANA" : (NombreProvincia == "NO REGISTRADO" ? "NO REGISTRADO" : "PROVINCIAS")</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Cargar DimCliente\Columna derivada.Outputs[Salida de columna derivada].Columns[TipoCliente]"
