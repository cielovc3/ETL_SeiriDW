                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión de columna derivada"
                          name="Expression">#{Package\Cargar DimCliente\Combinación de mezcla 2.Outputs[Salida de combinación de mezcla].Columns[TipoDocumento]} == "RUC" ? "EMPRESA" : (#{Package\Cargar DimCliente\Combinación de mezcla 2.Outputs[Salida de combinación de mezcla].Columns[TipoDocumento]} == "PUBLICO GENERAL" ? "PUBLICO GENERAL" : "PERSONA")</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Expresión descriptiva de columna derivada"
                          expressionType="Notify"
                          name="FriendlyExpression">TipoDocumento == "RUC" ? "EMPRESA" : (TipoDocumento == "PUBLICO GENERAL" ? "PUBLICO GENERAL" : "PERSONA")</property>
